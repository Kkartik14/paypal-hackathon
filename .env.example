# ---------------------------------------------------------------------------
# ScamBrake API environment (copy to .env at the repository root)
# The API loads the root .env, then apps/api/.env, then the process environment.
# ---------------------------------------------------------------------------

# AI provider: "mock" is the labelled demo engine and needs no key.
# If GROQ_API_KEY is set and AI_PROVIDER is unset, Groq is used automatically.
AI_PROVIDER=mock
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# Optional OpenAI-compatible Groq API base. Keep the default in production.
GROQ_API_BASE=https://api.groq.com/openai/v1

# PayPal Orders v2 Sandbox ONLY. Live credentials are refused at startup.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: the Sandbox business account that should receive the demo payment.
# When set, the server verifies the order's payee before capture.
PAYPAL_PAYEE_EMAIL=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Decision tickets. Generate with: openssl rand -hex 32
# Required (>= 32 characters) when NODE_ENV=production.
DECISION_TICKET_SECRET=
DECISION_TICKET_TTL_SECONDS=1200

# Optional bearer token for the read-only MCP endpoint. Empty means public.
MCP_API_KEY=

# Server
PORT=4000
# Comma-separated exact origins allowed by CORS.
WEB_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
